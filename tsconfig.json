{
  // Astro's own strict settings — this turns on every safety check for
  // both the .ts files and the TypeScript inside .astro pages.
  "extends": "astro/tsconfigs/strict",

  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],

  "compilerOptions": {
    // Extra checks on top of Astro's defaults.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  }
}
