---
/* ==========================================================
   PROMOTIONS PAGE — bonuses, weekly offers and the VIP club
   ========================================================== */

import Base from '../layouts/Base.astro';

interface Bonus { deposit: string; percent: string; detail: string; terms: string; best?: boolean; }
interface Promo { icon: string; title: string; text: string; terms: string; }
interface Tier  { icon: string; name: string; cashback: string; perk: string; }
interface Faq   { question: string; answer: string; }

const welcomePackage: readonly Bonus[] = [
  { deposit: '1st deposit', percent: '100%', detail: 'up to $500 + 200 free spins',
    terms: 'Min. $20. Wagering 35×. Max bet $5 while wagering.', best: true },
  { deposit: '2nd deposit', percent: '75%',  detail: 'up to $300 + 50 free spins',
    terms: 'Min. $20. Wagering 35×. Valid 30 days.' },
  { deposit: '3rd deposit', percent: '50%',  detail: 'up to $200 + 50 free spins',
    terms: 'Min. $20. Wagering 35×. Valid 30 days.' },
];

const weeklyPromos: readonly Promo[] = [
  { icon: '🔄', title: 'Monday Reload',
    text: '50% up to $150 on your first deposit every Monday. Start the week with extra balance.',
    terms: 'Wagering 30×. Once per week.' },
  { icon: '💸', title: 'Weekend Cashback',
    text: 'Get 10% of your net losses back every Monday morning — with zero wagering requirement.',
    terms: 'Min. cashback $10. Max $500.' },
  { icon: '🎁', title: 'Free Spins Friday',
    text: 'Deposit $50 on Friday and receive 100 free spins on the game of the week.',
    terms: 'Spins valid 7 days. Wagering 20×.' },
  { icon: '🏆', title: 'Slot Tournaments',
    text: 'A $10,000 prize pool split between the top 100 players every two weeks.',
    terms: 'Free to enter. Min. bet $0.50.' },
  { icon: '👥', title: 'Refer a Friend',
    text: 'Both of you get $25 when your friend registers and makes their first deposit.',
    terms: 'Max 10 referrals per month.' },
  { icon: '🎂', title: 'Birthday Bonus',
    text: 'A personal bonus lands in your account on your birthday. The higher your VIP tier, the bigger it is.',
    terms: 'Requires verified account.' },
];

const vipTiers: readonly Tier[] = [
  { icon: '🥉', name: 'Bronze',  cashback: '5% cashback',  perk: 'Standard support' },
  { icon: '🥈', name: 'Silver',  cashback: '8% cashback',  perk: 'Faster withdrawals' },
  { icon: '🥇', name: 'Gold',    cashback: '12% cashback', perk: 'Personal manager' },
  { icon: '👑', name: 'Diamond', cashback: '18% cashback', perk: 'Custom limits & gifts' },
];

const bonusFaqs: readonly Faq[] = [
  { question: 'What is a wagering requirement?',
    answer: 'It is how much you must bet before bonus money becomes withdrawable cash. "35×" on a $100 bonus means $3,500 in total bets.' },
  { question: 'Can I withdraw a bonus straight away?',
    answer: 'No. Bonus funds must be wagered first. Your own deposited money can be withdrawn at any time, but doing so cancels the active bonus.' },
  { question: 'Do bonuses expire?',
    answer: 'Yes — most are valid for 30 days, free spins for 7 days. Anything unused after that is removed automatically.' },
  { question: 'Is there a maximum bet while wagering?',
    answer: 'Yes, $5 per spin or hand. Bets above that may void the bonus, so keep stakes low until wagering is complete.' },
];

const termsStyle = 'color:var(--text-dim); font-size:.75rem; margin-top:14px;';
---

<Base
  title="Promotions & Bonuses | Blue Lagoon Casino"
  description="Welcome bonus up to $1,000 + 200 free spins, weekly reloads, cashback, tournaments and the Blue Lagoon VIP club."
  active="promotions"
>

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Bonuses</span>
      <h1>Every deposit gets <span class="neon-text">rewarded</span></h1>
      <p>New player? Start with $1,000 + 200 spins. Already with us? There's something every day of the week.</p>
    </div>
  </section>

  <!-- ===== WELCOME PACKAGE ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">For new players</span>
        <h2>Welcome package</h2>
        <p>Claimed automatically at deposit. No promo code needed.</p>
      </div>
      <div class="grid grid-3">
        {welcomePackage.map((bonus) => (
          <div class="promo-card">
            {bonus.best && <span class="tag">Best value</span>}
            <h3>{bonus.deposit}</h3>
            <div class="amount neon-text">{bonus.percent}</div>
            <p>{bonus.detail}</p>
            <a href="#" class={bonus.best ? 'btn btn-primary' : 'btn btn-ghost'}>Claim now</a>
            <div class="terms">{bonus.terms}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ONGOING PROMOTIONS ===== -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">For everyone</span>
        <h2>Weekly promotions</h2>
      </div>
      <div class="grid grid-3">
        {weeklyPromos.map((promo) => (
          <div class="card">
            <div class="icon">{promo.icon}</div>
            <h3>{promo.title}</h3>
            <p>{promo.text}</p>
            <div class="terms" style={termsStyle}>{promo.terms}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== VIP CLUB ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Loyalty</span>
        <h2>The VIP Club</h2>
        <p>Every bet earns points. Points move you up the tiers — and tiers never expire.</p>
      </div>
      <div class="grid grid-4">
        {vipTiers.map((tier) => (
          <div class="card" style="text-align:center;">
            <div class="icon">{tier.icon}</div>
            <h3>{tier.name}</h3>
            <p>{tier.cashback}<br />{tier.perk}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BONUS RULES — important for trust and for regulators ===== -->
  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <h2>Bonus terms in plain words</h2>
      </div>
      {bonusFaqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
      <div style="text-align:center; margin-top:24px;">
        <a href="#" class="btn btn-ghost">Read full bonus Terms &amp; Conditions</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="cta-band">
        <h2>Claim your welcome bonus</h2>
        <p>$1,000 + 200 free spins across your first three deposits.</p>
        <a href="#" class="btn btn-primary btn-lg">Sign up &amp; claim</a>
      </div>
    </div>
  </section>

</Base>
