---
/* ==========================================================
   RESPONSIBLE GAMING PAGE
   ----------------------------------------------------------
   Limits, self-exclusion and independent support services.
   Every real casino is required to publish a page like this.
   ========================================================== */

import Base from '../layouts/Base.astro';

interface Tool     { icon: string; title: string; text: string; }
interface HelpLine { name: string; text: string; href?: string; }

const accountTools: readonly Tool[] = [
  { icon: '💰', title: 'Deposit limits',
    text: 'Cap how much you can deposit per day, week or month. Lowering a limit applies instantly; raising it takes 24 hours.' },
  { icon: '⏱️', title: 'Session reminders',
    text: 'Get a pop-up after 30, 60 or 120 minutes of play showing how long you have been on site and your net result.' },
  { icon: '📉', title: 'Loss limits',
    text: 'Set a maximum you are willing to lose in a set period. Once reached, betting is paused until the period resets.' },
  { icon: '⏸️', title: 'Time-out',
    text: 'Take a short break — 24 hours, 7 days or 30 days. Your account is locked and all marketing stops.' },
  { icon: '🚫', title: 'Self-exclusion',
    text: 'Close your account for 6 months, 1 year, 5 years or permanently. This cannot be reversed early.' },
  { icon: '📊', title: 'Account history',
    text: 'See every deposit, bet and withdrawal you have made, at any time, in your account statement.' },
];

const warningSigns: readonly string[] = [
  'Do you gamble to escape stress, boredom or low mood?',
  'Have you tried to win back money you lost ("chasing losses")?',
  'Do you spend more money or time than you planned?',
  'Have you borrowed money or sold anything to gamble?',
  'Have you hidden your gambling from family or friends?',
  'Has gambling affected your work, studies or relationships?',
];

// `href` is optional — the last entry is our own support team, not a link.
const helpLines: readonly HelpLine[] = [
  { name: 'BeGambleAware',     href: 'https://www.begambleaware.org',
    text: 'Free advice and a 24/7 national helpline. begambleaware.org' },
  { name: 'GamCare',           href: 'https://www.gamcare.org.uk',
    text: 'Support, counselling and live chat for players and their families. gamcare.org.uk' },
  { name: 'Gambling Therapy',  href: 'https://www.gamblingtherapy.org',
    text: 'Online support in multiple languages, worldwide. gamblingtherapy.org' },
  { name: 'Gamblers Anonymous', href: 'https://www.gamblersanonymous.org',
    text: 'Peer support meetings, online and in person. gamblersanonymous.org' },
  { name: 'GAMSTOP',           href: 'https://www.gamstop.co.uk',
    text: 'Block yourself from all licensed UK gambling sites at once. gamstop.co.uk' },
  { name: 'Our support team',
    text: 'Live chat 24/7, or email support@bluelagoon.com — we can set limits for you.' },
];
---

<Base
  title="Responsible Gaming | Blue Lagoon Casino"
  description="Deposit limits, loss limits, time-outs and self-exclusion at Blue Lagoon Casino, plus independent support organisations."
  active="responsible"
>

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Safer gambling</span>
      <h1>Play for fun, <span class="neon-text">stay in control</span></h1>
      <p>Gambling should be entertainment — never a way to make money or solve financial problems.</p>
    </div>
  </section>

  <!-- ===== TOOLS WE OFFER ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Your account tools</span>
        <h2>Set your own limits</h2>
        <p>All of these are free, available in your account settings, and take effect immediately.</p>
      </div>
      <div class="grid grid-3">
        {accountTools.map((tool) => (
          <div class="card">
            <div class="icon">{tool.icon}</div>
            <h3>{tool.title}</h3>
            <p>{tool.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== WARNING SIGNS ===== -->
  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">Self-check</span>
        <h2>Signs it may be a problem</h2>
        <p>If you answer yes to any of these, please consider using the tools above or
           contacting one of the organisations below.</p>
      </div>
      <ul style="display:grid; gap:12px;">
        {warningSigns.map((sign) => <li class="card">{sign}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===== WHERE TO GET HELP ===== -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Free &amp; confidential</span>
        <h2>Where to get help</h2>
        <p>These organisations are independent of Blue Lagoon Casino.</p>
      </div>
      <div class="grid grid-3">
        {helpLines.map((line) => (
          line.href
            ? <a class="card" href={line.href}><h3>{line.name}</h3><p>{line.text}</p></a>
            : <div class="card"><h3>{line.name}</h3><p>{line.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== UNDERAGE ===== -->
  <section class="section section-alt">
    <div class="container" style="max-width:820px; text-align:center;">
      <span class="age-badge" style="margin:0 auto 18px;">18+</span>
      <h2>Protecting minors</h2>
      <p style="color:var(--text-dim); margin-top:14px;">
        It is illegal for anyone under 18 to gamble. We verify the age of every player
        before they can withdraw. If you share a device with children, we recommend
        blocking software such as
        <a href="https://www.netnanny.com" style="color:var(--aqua);">Net Nanny</a> or
        <a href="https://famisafe.wondershare.com" style="color:var(--aqua);">FamiSafe</a>,
        and never saving your password in the browser.
      </p>
    </div>
  </section>

</Base>
