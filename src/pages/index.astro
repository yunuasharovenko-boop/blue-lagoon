---
/* ==========================================================
   HOME PAGE
   ----------------------------------------------------------
   The repeated blocks (bonus cards, game tiles, FAQ entries)
   are written once as typed lists and then looped over. Add a
   game to the `popularGames` list and a new tile appears.
   ========================================================== */

import Base from '../layouts/Base.astro';
import SlotMachine from '../components/SlotMachine.astro';
import { url } from '../lib/urls';

interface Stat  { value: string; label: string; }
interface Bonus { deposit: string; percent: string; detail: string; popular?: boolean; }
interface Game  { icon: string; name: string; detail: string; }
interface Step  { number: string; title: string; text: string; }
interface Card  { icon: string; title: string; text: string; }
interface Faq   { question: string; answer: string; }

const stats: readonly Stat[] = [
  { value: '3,000+', label: 'Games' },
  { value: '50+',    label: 'Providers' },
  { value: '$2.4M',  label: 'Paid this month' },
  { value: '24/7',   label: 'Support' },
];

const bonuses: readonly Bonus[] = [
  { deposit: '1st deposit', percent: '100%', detail: 'up to $500 + 200 free spins on Starburst', popular: true },
  { deposit: '2nd deposit', percent: '75%',  detail: 'up to $300 + 50 free spins on Book of Dead' },
  { deposit: '3rd deposit', percent: '50%',  detail: "up to $200 + 50 free spins on Gonzo's Quest" },
];

const popularGames: readonly Game[] = [
  { icon: '🍒', name: 'Fruit Fiesta',    detail: 'Slot · RTP 96.4%' },
  { icon: '🎰', name: 'Mega Jackpot',    detail: 'Slot · Jackpot $1.2M' },
  { icon: '🃏', name: 'Live Blackjack',  detail: 'Live · 12 tables' },
  { icon: '🎡', name: 'Lagoon Roulette', detail: 'Live · European' },
  { icon: '💎', name: 'Diamond Rush',    detail: 'Slot · RTP 97.1%' },
  { icon: '👑', name: 'Royal Poker',     detail: "Table · Hold'em" },
  { icon: '🔥', name: 'Hot Neon 7s',     detail: 'Slot · RTP 96.0%' },
  { icon: '🐬', name: 'Blue Lagoon',     detail: 'Exclusive · RTP 96.8%' },
];

const steps: readonly Step[] = [
  { number: '1', title: 'Create an account', text: 'Email and password only. Registration takes about 60 seconds.' },
  { number: '2', title: 'Make a deposit',    text: 'Visa, Mastercard, Apple Pay, crypto and bank transfer. From $20.' },
  { number: '3', title: 'Play & withdraw',   text: 'Your bonus is added instantly. Withdrawals processed within 24 hours.' },
];

const whyUs: readonly Card[] = [
  { icon: '⚡',  title: 'Fast payouts',    text: 'Most withdrawals are approved within one hour of verification.' },
  { icon: '🔒', title: 'Safe & licensed', text: '256-bit SSL encryption and independently audited random number generators.' },
  { icon: '💬', title: 'Real support',    text: 'Live chat with a human agent, 24 hours a day, in 6 languages.' },
  { icon: '📱', title: 'Any device',      text: 'Works in the browser on phone, tablet and desktop. Nothing to install.' },
];

const payments: readonly Card[] = [
  { icon: '💳', title: 'Visa / Mastercard', text: 'Instant deposit · 1–3 days out' },
  { icon: '🏦', title: 'Bank transfer',     text: 'Instant deposit · 1–5 days out' },
  { icon: '₿',  title: 'Crypto',            text: 'BTC, ETH, USDT · under 1 hour' },
  { icon: '📲', title: 'E-wallets',         text: 'Skrill, Neteller · instant' },
];

const faqs: readonly Faq[] = [
  { question: 'How do I claim the welcome bonus?',
    answer: 'Register an account, then make a deposit of $20 or more. The bonus and free spins are credited automatically — there is no promo code to enter.' },
  { question: 'What does "wagering 35×" mean?',
    answer: 'Before a bonus can be withdrawn as cash, you need to place bets totalling 35 times the bonus amount. Example: a $100 bonus requires $3,500 in bets.' },
  { question: 'How long do withdrawals take?',
    answer: 'Crypto usually arrives within an hour. Cards and bank transfers take 1–5 working days depending on your bank. First withdrawal requires ID verification.' },
  { question: 'Is Blue Lagoon Casino licensed?',
    answer: 'Yes. Our licence number and regulator are listed in the footer of every page. All games are tested by an independent laboratory.' },
];
---

<Base
  title="Blue Lagoon Casino — Online Slots, Live Games & Bonuses"
  description="Play 3,000+ slots, live dealer tables and jackpots at Blue Lagoon Casino. Welcome bonus up to $1,000 + 200 free spins. Fast payouts, 24/7 support."
  active="home"
>

  <!-- ===== HERO — the first screen ===== -->
  <section class="hero">
    <div class="container">

      <span class="eyebrow">♣ · ◇ · ♥ · ♠ &nbsp;Licensed online casino</span>

      <h1>Welcome to the <span class="lagoon-text">Blue Lagoon</span><br />Casino Night</h1>

      <p class="lead">
        Over 3,000 slots, live dealer tables and daily jackpots.
        Claim your welcome package and start playing in under 2 minutes.
      </p>

      <div class="hero-buttons">
        <a href="#" class="btn btn-primary btn-lg">Claim $1,000 bonus</a>
        <a href={url('games')} class="btn btn-ghost btn-lg">Browse games</a>
      </div>

      <div class="hero-trust">
        <span>Payouts in 1–24 hours</span>
        <span>Licensed &amp; SSL encrypted</span>
        <span>24/7 live support</span>
      </div>

      <div class="hero-banner">
        <img src={url('images/IMG_2852.PNG')} alt="Blue Lagoon Casino Night banner" />
      </div>

    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="stats">
        {stats.map((stat) => (
          <div>
            <div class="value">{stat.value}</div>
            <div class="label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== THE PLAYABLE GAME ===== -->
  <SlotMachine />

  <!-- ===== WELCOME BONUS ===== -->
  <section class="section section-alt" id="bonus">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">Welcome package</span>
        <h2>Your first three deposits, boosted</h2>
        <p>New players only. Each bonus is claimed automatically at deposit —
           no promo code needed.</p>
      </div>

      <div class="grid grid-3">
        {bonuses.map((bonus) => (
          <div class="promo-card">
            {bonus.popular && <span class="tag">Most popular</span>}
            <h3>{bonus.deposit}</h3>
            <div class="amount neon-text">{bonus.percent}</div>
            <p>{bonus.detail}</p>
            <a href="#" class={bonus.popular ? 'btn btn-primary' : 'btn btn-ghost'}>Claim now</a>
            <div class="terms">Min. deposit $20. Wagering 35×. T&amp;C apply.</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===== POPULAR GAMES ===== -->
  <section class="section" id="games">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">Lobby</span>
        <h2>Popular right now</h2>
        <p>Slots, live dealers, roulette and jackpots from the world's top studios.</p>
      </div>

      <div class="grid grid-4">
        {popularGames.map((game) => (
          <article class="game-card">
            <div class="game-thumb">{game.icon}</div>
            <div class="body">
              <h3>{game.name}</h3>
              <span>{game.detail}</span>
            </div>
          </article>
        ))}
      </div>

      <div style="text-align:center; margin-top:36px;">
        <a href={url('games')} class="btn btn-gold btn-lg">See all 3,000+ games</a>
      </div>

    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="section section-alt" id="how">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">Getting started</span>
        <h2>Playing takes 3 steps</h2>
      </div>

      <div class="grid grid-3">
        {steps.map((step) => (
          <div class="step">
            <div class="num">{step.number}</div>
            <h3>{step.title}</h3>
            <p style="color:var(--text-dim);">{step.text}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===== WHY US ===== -->
  <section class="section">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">Why Blue Lagoon</span>
        <h2>Built for players, not for waiting</h2>
      </div>

      <div class="grid grid-4">
        {whyUs.map((card) => (
          <div class="card">
            <div class="icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===== PAYMENT METHODS ===== -->
  <section class="section section-alt">
    <div class="container">

      <div class="section-head">
        <span class="eyebrow">Banking</span>
        <h2>Deposit and withdraw your way</h2>
        <p>No fees from our side. Minimum deposit $20, minimum withdrawal $30.</p>
      </div>

      <div class="grid grid-4">
        {payments.map((method) => (
          <div class="card" style="text-align:center;">
            <div class="icon">{method.icon}</div>
            <h3>{method.title}</h3>
            <p>{method.text}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===== FAQ — opens without any JavaScript ===== -->
  <section class="section">
    <div class="container" style="max-width:820px;">

      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Frequently asked</h2>
      </div>

      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}

      <details class="faq-item">
        <summary>Can I set limits on my account?</summary>
        <p>Yes. You can set deposit, loss and session limits, take a time-out, or
           self-exclude at any time. See our
           <a href={url('responsible-gaming')} style="color:var(--aqua);">Responsible Gaming</a> page.</p>
      </details>

    </div>
  </section>

  <!-- ===== FINAL CALL TO ACTION ===== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="cta-band">
        <h2>Ready to play?</h2>
        <p>Join thousands of players at Blue Lagoon. Your first bonus is waiting.</p>
        <a href="#" class="btn btn-primary btn-lg">Create free account</a>
      </div>
    </div>
  </section>

</Base>
